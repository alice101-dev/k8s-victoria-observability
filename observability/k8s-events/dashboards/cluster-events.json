      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "container": 2,
              "reason": 3,
              "Value": 4
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "container": "Container",
              "reason": "Termination reason",
              "Value": "Restarts"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (namespace, pod, container, reason) (max_over_time(kube_pod_container_status_last_terminated_reason{namespace=~\"${namespace:regex}\"}[$__range])) * on (namespace, pod, container) group_left () (sum by (namespace, pod, container) (round(increase(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[$__range]))) > 0) or on (namespace, pod, container) (sum by (namespace, pod, container) (round(increase(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[$__range]))) > 0)",
