{
  "uid": "cluster-events",
  "title": "Cluster — Events",
  "description": "Kubernetes events from VictoriaLogs (all namespaces): warnings by reason and namespace, node restarts and spot preemptions, why pods fail (scheduling, probes, OOM, image pulls), restarts and the event pipeline.",
  "tags": [
    "kubernetes",
    "events"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "VictoriaLogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "k8s.namespace.name",
          "query": "{service.name=\"kubernetes-events\"} k8s.namespace.name:*",
          "limit": 200,
          "refId": "namespace"
        },
        "definition": "k8s.namespace.name: {service.name=\"kubernetes-events\"}",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "type",
        "label": "Type",
        "type": "custom",
        "query": "Warning,Normal",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "Warning"
          ],
          "value": [
            "Warning"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "Warning",
            "value": "Warning"
          },
          {
            "selected": false,
            "text": "Normal",
            "value": "Normal"
          }
        ]
      },
      {
        "name": "search",
        "label": "Message contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Case-insensitive text in the message"
      },
      {
        "name": "filters",
        "label": "Filters",
        "type": "adhoc",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "VictoriaLogs"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Shop dashboards",
      "type": "dashboards",
      "tags": [
        "shop"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\"}",
      "targetBlank": true
    },
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaLogs\"}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Node restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "useValueForTime": false,
        "expr": "max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) > max_over_time((max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)))[30m:1m] offset 1m)",
        "titleFormat": "Node restarted: {{node}}",
        "textFormat": "Spot preemption, upgrade or repair: its pods were rescheduled"
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "orange",
        "step": "1m",
        "useValueForTime": false,
        "expr": "(changes(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[1m]) > 0) * on (namespace, pod, container) group_left (reason) max by (namespace, pod, container, reason) (kube_pod_container_status_last_terminated_reason{namespace=~\"${namespace:regex}\"})",
        "titleFormat": "Restart {{pod}}: {{reason}}",
        "textFormat": "Container {{container}} (OOMKilled: memory limit reached)"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview — $namespace",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Warning events",
      "description": "Events of type Warning, including repeats of the same event.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} (k8s.namespace.name:in($namespace) or k8s.namespace.name:=\"\") _msg:~`(?i)\\Q${search:raw}\\E` severity_text:=Warning | stats count() events",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Pods that could not be scheduled",
      "description": "Pods the scheduler could not place: not enough CPU or memory, node affinity, taints or volumes. After a spot preemption the remaining nodes may be too full.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} (k8s.namespace.name:in($namespace) or k8s.namespace.name:=\"\") _msg:~`(?i)\\Q${search:raw}\\E` k8s.event.reason:=FailedScheduling | stats count_uniq(k8s.object.name) pods",
          "queryType": "stats",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Failed probes",
      "description": "Readiness and liveness probe failures (the pod leaves its Service, or the container is restarted).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} (k8s.namespace.name:in($namespace) or k8s.namespace.name:=\"\") _msg:~`(?i)\\Q${search:raw}\\E` k8s.event.reason:=Unhealthy | stats count() events",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "OOM kills",
      "description": "Processes the kernel killed at a container memory limit, reported by node-problem-detector on the node (all namespaces; the event names the process, the pod shows under Container restarts).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} k8s.event.reason:=OOMKilling _msg:~`(?i)\\Q${search:raw}\\E` | stats count_uniq(_msg) kills",
          "queryType": "stats",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Container restarts",
      "description": "Container restarts in the time range; the reasons are in the Container restarts table.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(round(increase(kube_pod_container_status_restarts_total{namespace=~\"${namespace:regex}\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Node restarts",
      "description": "Nodes that booted in the time range: spot VM preemption, node upgrade or repair, or a new node. Their pods were rescheduled; the Nodes row shows when.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(time() - max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) < $__range_s)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Warning events by reason",
      "description": "FailedScheduling: no node fits. Unhealthy: probe failed. BackOff: crash or image pull loop. Failed: image pull or container start failed. OOMKilling: memory limit. Evicted / Preempting: node pressure or a higher-priority pod.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} (k8s.namespace.name:in($namespace) or k8s.namespace.name:=\"\") _msg:~`(?i)\\Q${search:raw}\\E` severity_text:=Warning | stats by (k8s.event.reason) count() events",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A",
          "legendFormat": "{{k8s.event.reason}}"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "interval": "1m"
    },
    {
      "type": "status-history",
      "title": "Warning events per namespace",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "maxDataPoints": 60,
      "description": "When each namespace had warnings; (cluster) is nodes and other cluster-scoped objects.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.85,
        "colWidth": 0.95,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{service.name=\"kubernetes-events\"} (k8s.namespace.name:in($namespace) or k8s.namespace.name:=\"\") _msg:~`(?i)\\Q${search:raw}\\E` severity_text:=Warning | copy k8s.namespace.name as namespace | format if (namespace:=\"\") \"(cluster)\" as namespace | stats by (namespace) count() events",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "interval": "1m"
    },
    {
      "type": "row",
      "title": "Nodes — restarts and spot preemptions",
      "collapsed": false,
      "panels": [],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Nodes",
      "description": "When each node last booted. A recent boot on a spot node usually is a preemption: Compute Engine reclaimed the VM, GKE recreated it and its pods were rescheduled.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Booted"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Ready",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "NotReady",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Booted",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Booted",
              "Value #B": "Ready"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) * 1000",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (node) (kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "links": [
        {
          "title": "Open Kubernetes / Views / Nodes",
          "url": "/d/k8s_views_nodes/kubernetes-views-nodes?${__url_time_range}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ready nodes",
      "description": "Ready nodes against all nodes: a dip is a node lost (preemption, upgrade) until it is back.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "legendFormat": "ready",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(kube_node_info)",
          "legendFormat": "nodes",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "links": [
        {
          "title": "Open Kubernetes / Views / Nodes",
          "url": "/d/k8s_views_nodes/kubernetes-views-nodes?${__url_time_range}"
        }
      ]
    },
    {
      "type": "logs",
