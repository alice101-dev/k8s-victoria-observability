{
  "uid": "gateway-edge",
  "title": "Gateway — Edge",
  "description": "The internal edge Gateway (kgateway, Envoy): traffic, errors and latency at the listener, every routed backend, OTLP access logs with their traces, and the health of the proxies and controller.",
  "tags": [
    "platform",
    "gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Platform dashboards",
      "type": "dashboards",
      "tags": [
        "platform"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore gateway traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"search\",\"service\":\"edge-gateway\"}]}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Node restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "useValueForTime": false,
        "expr": "(max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)) > max_over_time((max by (node) (label_replace(node_boot_time_seconds, \"internal_ip\", \"$1\", \"instance\", \"(.+):[0-9]+\") * on (internal_ip) group_left (node) max by (internal_ip, node) (kube_node_info)))[30m:1m] offset 1m)) * on (node) group_left (label_cloud_google_com_gke_nodepool, label_cloud_google_com_gke_provisioning) max by (node, label_cloud_google_com_gke_nodepool, label_cloud_google_com_gke_provisioning) (kube_node_labels)",
        "titleFormat": "Node restarted: {{node}}",
        "textFormat": "Pool {{label_cloud_google_com_gke_nodepool}} ({{label_cloud_google_com_gke_provisioning}}): spot preemption, upgrade or repair; its pods were rescheduled"
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "orange",
        "step": "1m",
        "useValueForTime": false,
        "expr": "(changes(kube_pod_container_status_restarts_total{namespace=\"kgateway-system\"}[1m]) > 0) * on (namespace, pod, container) group_left (reason) max by (namespace, pod, container, reason) (kube_pod_container_status_last_terminated_reason{namespace=\"kgateway-system\"})",
        "titleFormat": "Restart {{pod}}: {{reason}}",
        "textFormat": "Container {{container}} (OOMKilled: memory limit reached)"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "Requests per second at the gateway listener (port 80), all routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(envoy_http_downstream_rq_xx{job=\"kgateway-system/kgateway-proxy\", envoy_http_conn_manager_prefix=\"http\"}[5m])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "5xx ratio",
      "description": "Share of responses with status 5xx over the last 5 minutes. Above 5% for 10 minutes fires GatewayHighErrorRate.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(sum(rate(envoy_http_downstream_rq_xx{job=\"kgateway-system/kgateway-proxy\", envoy_http_conn_manager_prefix=\"http\", envoy_response_code_class=\"5\"}[5m])) / sum(rate(envoy_http_downstream_rq_xx{job=\"kgateway-system/kgateway-proxy\", envoy_http_conn_manager_prefix=\"http\"}[5m]))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile of the time from the first byte received to the last byte sent, gateway included.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(envoy_http_downstream_rq_time_bucket{job=\"kgateway-system/kgateway-proxy\", envoy_http_conn_manager_prefix=\"http\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Proxies up",
      "description": "Envoy replicas of the edge Gateway that are scraped as up.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(up{job=\"kgateway-system/kgateway-proxy\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
