    {
      "type": "stat",
      "title": "p95 tool duration, slowest server",
      "description": "The highest 95th percentile tool duration among the servers that report the OpenTelemetry MCP metric mcp.server.operation.duration, over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(histogram_quantile(0.95, sum by (server, le) (label_replace(label_replace(label_replace(increase(mcp_server_operation_duration_seconds_bucket{mcp_method_name=\"tools/call\"}[$__range]), \"server\", \"$1\", \"job\", \"(?:.*/)?(.+)\"), \"server\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"tool\", \"$1\", \"gen_ai_tool_name\", \"(.+)\"))))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
