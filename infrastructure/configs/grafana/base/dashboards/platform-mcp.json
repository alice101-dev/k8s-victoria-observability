{
  "uid": "platform-mcp",
  "title": "Platform — MCP servers",
  "description": "The MCP servers that give AI clients access to metrics, logs, traces, Grafana and PostgreSQL: which tools are called, failures, durations, sessions, backend calls and resources. Servers are discovered from the MCP metrics they report.",
  "tags": [
    "platform",
    "mcp",
    "custom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Platform dashboards",
      "type": "dashboards",
      "tags": [
        "platform"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\"}",
      "targetBlank": true
    },
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaLogs\"}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Servers reporting",
      "description": "MCP servers that reported MCP metrics in the last 5 minutes, scraped or sent over OTLP.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(count by (server) (label_replace(label_replace(last_over_time({__name__=~\"mcp_.+\"}[5m]), \"server\", \"$1\", \"job\", \"(?:.*/)?(.+)\"), \"server\", \"$1\", \"k8s_deployment_name\", \"(.+)\"))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "description": "Tools the AI clients called on every MCP server in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(sum by (server, tool) (label_replace(label_replace(label_replace(increase({__name__=~\"mcp_.+_call_tool_total\"}[$__range]), \"server\", \"$1\", \"job\", \"(?:.*/)?(.+)\"), \"server\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"tool\", \"$1\", \"name\", \"(.+)\")) or sum by (server, tool) (label_replace(label_replace(label_replace(increase(mcp_server_operation_duration_seconds_count{mcp_method_name=\"tools/call\"}[$__range]), \"server\", \"$1\", \"job\", \"(?:.*/)?(.+)\"), \"server\", \"$1\", \"k8s_deployment_name\", \"(.+)\"), \"tool\", \"$1\", \"gen_ai_tool_name\", \"(.+)\"))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
