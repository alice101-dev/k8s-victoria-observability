    {
      "type": "table",
      "title": "Services",
      "description": "Every deus service now: ready pods, traffic, errors and latency of the last 5 minutes, and availability over the SLO window. Click a service for its dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Deus — Service",
                    "url": "/d/deus-service/deus-service?var-service=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
