      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "(sum(rate(grafana_http_request_duration_seconds_count{job=\"grafana\", status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(grafana_http_request_duration_seconds_count{job=\"grafana\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
