          },
          "expr": "sum(rate(redis_net_input_bytes_total[$__rate_interval]))",
          "legendFormat": "in",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(redis_net_output_bytes_total[$__rate_interval]))",
          "legendFormat": "out",
