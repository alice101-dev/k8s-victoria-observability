# Copy to .env (git-ignored) and fill in. Read by terraform/Makefile and apps/Makefile.
# The project ID and repo URL are deliberately kept out of committed files.
#   cp .env.example .env

# Required: target GCP project. The Makefiles refuse to run if `gcloud config get-value project` differs.
PROJECT_ID=

# Optional: HTTPS URL of the GitOps repo synced by Argo CD.
# Empty = taken from `git remote get-url origin`.
GITOPS_REPO_URL=
