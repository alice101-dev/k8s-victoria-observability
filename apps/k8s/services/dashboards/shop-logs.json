{
  "uid": "shop-logs",
  "title": "Shop — Logs",
  "description": "Application logs of the shop services from VictoriaLogs.",
  "tags": [
    "shop",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(http_server_requests_total{namespace=\"shop\"}, job)",
          "refId": "service"
        },
        "definition": "label_values(http_server_requests_total{namespace=\"shop\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "ERROR",
            "WARN"
          ],
          "value": [
            "ERROR",
            "WARN"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "ERROR",
            "value": "ERROR"
          },
          {
            "selected": true,
            "text": "WARN",
            "value": "WARN"
          },
          {
            "selected": false,
            "text": "INFO",
            "value": "INFO"
          },
          {
            "selected": false,
            "text": "DEBUG",
            "value": "DEBUG"
          }
        ]
      },
      {
        "name": "filters",
        "label": "Filters",
        "type": "adhoc",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "VictoriaLogs"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Shop dashboards",
      "type": "dashboards",
      "tags": [
        "shop"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\"}",
      "targetBlank": true
    },
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaLogs\"}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Rollouts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "blue",
        "step": "1m",
        "useValueForTime": false,
        "expr": "changes(max by (deployment) (kube_deployment_metadata_generation{namespace=\"shop\"})[1m]) > 0 or changes(max by (statefulset) (kube_statefulset_metadata_generation{namespace=\"shop\"})[1m]) > 0",
        "titleFormat": "Rollout {{deployment}}{{statefulset}}",
        "textFormat": "Spec changed (image, env or resources)"
      },
      {
        "name": "Critical alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "red",
        "step": "1m",
        "useValueForTime": false,
        "expr": "max by (alertname, job, deployment, slo) (ALERTS{alertname=~\"Shop.*\", alertstate=\"firing\", severity=\"critical\"})",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{job}}{{deployment}} {{slo}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Volume",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DEBUG"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"shop\"} service:in($service) level:in($level) | stats by (level) count() logs",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Log volume by service",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"shop\"} service:in($service) level:in($level) | stats by (service) count() logs",
          "queryType": "statsRange",
          "editorMode": "code",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Top sources",
      "collapsed": false,
      "panels": [],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Top messages",
      "description": "The most frequent messages for the selected services and levels.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "service": 0,
              "level": 1,
              "_msg": 2,
              "Value": 3
            },
            "renameByName": {
              "service": "Service",
              "level": "Level",
              "_msg": "Message",
              "Value": "Count",
              "hits": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"shop\"} service:in($service) level:in($level) | stats by (service, level, _msg) count() hits | sort by (hits desc) | limit 15",
          "queryType": "stats",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Top pods",
      "description": "A single pod at the top usually means a node or pod-local problem rather than a code bug.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "kubernetes.pod_name": 0,
              "Value": 1
            },
            "renameByName": {
              "kubernetes.pod_name": "Pod",
              "Value": "Count",
              "hits": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"shop\"} service:in($service) level:in($level) | stats by (kubernetes.pod_name) count() hits | sort by (hits desc) | limit 10",
          "queryType": "stats",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 14,
        "y": 10,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "Expand a line and follow trace_id to open the trace. Add field filters with the Filters variable.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"shop\"} service:in($service) level:in($level)",
          "queryType": "instant",
          "editorMode": "code",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 16
      }
    }
  ]
}
