{
  "uid": "shop-slo",
  "title": "Shop — SLO Overview",
  "description": "Availability and latency SLOs per service: error budget, burn rates and alerts.",
  "tags": [
    "shop",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Shop dashboards",
      "type": "dashboards",
      "tags": [
        "shop"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\"}",
      "targetBlank": true
    },
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaLogs\"}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Rollouts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "blue",
        "step": "1m",
        "useValueForTime": false,
        "expr": "changes(max by (deployment) (kube_deployment_metadata_generation{namespace=\"shop\"})[1m]) > 0 or changes(max by (statefulset) (kube_statefulset_metadata_generation{namespace=\"shop\"})[1m]) > 0",
        "titleFormat": "Rollout {{deployment}}{{statefulset}}",
        "textFormat": "Spec changed (image, env or resources)"
      },
      {
        "name": "Critical alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "red",
        "step": "1m",
        "useValueForTime": false,
        "expr": "max by (alertname, job, deployment, slo) (ALERTS{alertname=~\"Shop.*\", alertstate=\"firing\", severity=\"critical\"})",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{job}}{{deployment}} {{slo}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "User journeys — measured at api-gateway",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Checkout · 5m",
      "description": "Share of checkout requests answered without a 5xx at the edge, including failures of every service behind it.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:sli_error:ratio_rate5m{job=\"checkout\", slo=\"availability\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 7
      }
    },
    {
      "type": "stat",
      "title": "Browse · 5m",
      "description": "Share of browse requests answered without a 5xx at the edge, including failures of every service behind it.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:sli_error:ratio_rate5m{job=\"browse\", slo=\"availability\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Journey SLOs",
      "description": "What users experience. A service that is down loses its own SLI (it receives no requests), but the journeys that depend on it keep burning here.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Journey"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open api-gateway dashboard",
                    "url": "/d/shop-service/shop-service?var-service=api-gateway&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Objective"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actual (30d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget remaining"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 0.25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate 1h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 14.4
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate 6h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Data in window"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Threshold"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no 5xx"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget gone in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 86400
                    },
                    {
                      "color": "green",
                      "value": 604800
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "exhausted",
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 31536000,
                      "to": null,
                      "result": {
                        "text": "not at this rate",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Budget remaining",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "cluster": true,
              "__name__": true,
              "Value #F": true
            },
            "indexByName": {
              "job": 0,
              "slo": 1,
              "Value #G": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #H": 8,
              "Value #F": 9
            },
            "renameByName": {
              "job": "Journey",
              "slo": "SLI",
              "Value #A": "Objective",
              "Value #B": "Actual (30d)",
              "Value #C": "Budget remaining",
              "Value #D": "Burn rate 1h",
              "Value #E": "Burn rate 6h",
              "Value #F": "Data in window",
              "Value #G": "Threshold",
              "Value #H": "Budget gone in"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:objective:ratio{kind=\"journey\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (1 - slo:sli_error:ratio_rate30d{kind=\"journey\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:error_budget_remaining:ratio{kind=\"journey\"})",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:sli_error:ratio_rate1h{kind=\"journey\"} / on (job, slo, kind) (1 - slo:objective:ratio))",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:sli_error:ratio_rate6h{kind=\"journey\"} / on (job, slo, kind) (1 - slo:objective:ratio))",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:sli_window:seconds{kind=\"journey\"})",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (slo:sli_threshold:seconds{kind=\"journey\"})",
          "legendFormat": "",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (job, slo) (clamp_max(clamp_min(slo:error_budget_remaining:ratio{kind=\"journey\"}, 0) * 2592000 / on (job, slo, kind) (slo:sli_error:ratio_rate1h{kind=\"journey\"} / on (job, slo, kind) (1 - slo:objective:ratio)), 31536000))",
          "legendFormat": "",
          "refId": "H",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 7
      }
    },
    {
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "panels": [],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Services without ready pods",
      "description": "A service with no ready pod is down even though its SLO rows stay quiet. Alert: ShopServiceDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(kube_deployment_status_replicas_available{namespace=\"shop\", deployment=~\"api-gateway|notification-service|order-service|payment-service|product-service|user-service\"} == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Ready pods per service",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (deployment) (kube_deployment_status_replicas_available{namespace=\"shop\", deployment=~\"api-gateway|notification-service|order-service|payment-service|product-service|user-service\"}) / max by (deployment) (kube_deployment_spec_replicas{namespace=\"shop\", deployment=~\"api-gateway|notification-service|order-service|payment-service|product-service|user-service\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 4,
        "y": 9,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "SLO data in window",
      "description": "How much data the 30-day window really holds. Below 30 days (e.g. a recently created cluster), budget figures describe only this period and a short incident looks much larger.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(slo:sli_window:seconds)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "SLO rules last evaluated",
      "description": "Age of the newest SLI sample. If vmalert or the metrics storage is down, the dashboard silently goes stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "time() - max(timestamp(slo:sli_error:ratio_rate5m))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
