    {
      "type": "row",
      "title": "Services — error budget (30-day window)",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Service SLOs",
      "description": "Availability = share of non-5xx responses; latency = share of requests faster than the service threshold. Burn rate 1 spends the budget in exactly 30 days; alerts page at 14.4 (1h) or 6 (6h). Budget gone in = remaining budget at the current 1h burn rate. Click a service to drill down.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open service dashboard",
                    "url": "/d/shop-service/shop-service?var-service=${__data.fields.job}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
