{
  "uid": "shop-slo",
  "title": "Shop — SLO Overview",
  "description": "Availability and latency SLOs per service: error budget, burn rates and alerts.",
  "tags": [
    "shop",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Shop dashboards",
      "type": "dashboards",
      "tags": [
        "shop"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Explore traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaTraces\"}",
      "targetBlank": true
    },
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"VictoriaLogs\"}",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Error budget — 30-day window",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "SLO status per service",
      "description": "Availability = share of non-5xx responses; latency = share of requests faster than the service threshold. Burn rate 1 spends the budget in exactly 30 days; alerts page at 14.4 (1h) or 6 (6h). Click a service to drill down.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open service dashboard",
                    "url": "/d/shop-service/shop-service?var-service=${__data.fields.job}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Objective"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actual (30d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget remaining"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 0.25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate 1h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 14.4
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Burn rate 6h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Budget remaining",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "cluster": true,
              "__name__": true
            },
            "indexByName": {
              "job": 0,
              "slo": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "job": "Service",
              "slo": "SLI",
              "Value #A": "Objective",
              "Value #B": "Actual (30d)",
              "Value #C": "Budget remaining",
              "Value #D": "Burn rate 1h",
              "Value #E": "Burn rate 6h"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:objective:ratio",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:error_budget_remaining:ratio",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:sli_error:ratio_rate1h / on (job, slo) (1 - slo:objective:ratio)",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:sli_error:ratio_rate6h / on (job, slo) (1 - slo:objective:ratio)",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 14
      }
    },
    {
      "type": "row",
      "title": "Burn rate",
      "collapsed": false,
      "panels": [],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate — 1h window",
      "description": "Pages when both the 1h and 5m burn rates exceed 14.4 (2% of the 30-day budget in one hour).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:sli_error:ratio_rate1h / on (job, slo) (1 - slo:objective:ratio)",
          "legendFormat": "{{job}} · {{slo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate — 6h window",
      "description": "Pages when both the 6h and 30m burn rates exceed 6 (5% of the 30-day budget in six hours).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          },
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:sli_error:ratio_rate6h / on (job, slo) (1 - slo:objective:ratio)",
          "legendFormat": "{{job}} · {{slo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "row",
      "title": "Budget and SLI trends",
      "collapsed": false,
      "panels": [],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Error budget remaining (30d)",
      "description": "Below 0 the SLO is violated for the 30-day window.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:error_budget_remaining:ratio",
          "legendFormat": "{{job}} · {{slo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Bad requests ratio — 5m",
      "description": "Share of requests that are 5xx (availability) or slower than the threshold (latency).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 0.01
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:sli_error:ratio_rate5m",
          "legendFormat": "{{job}} · {{slo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "panels": [],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Shop alerts — firing and pending",
      "description": "Alert state written by vmalert (ALERTS series). Burn-rate alerts carry the job and slo labels.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No Shop alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "cluster": true,
              "alertgroup": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "job": 3,
              "slo": 4,
              "service": 5
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "ALERTS{alertname=~\"Shop.*\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 6
      }
    }
  ]
}
